<resources>
    <color name="ghost_background">#10161A</color>
    <style name="GhostBufferTheme" parent="android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/ghost_background</item>
        <item name="android:colorBackground">@color/ghost_background</item>
        <item name="android:textColor">#F2F5F7</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="GhostEncoderTestButton" parent="android:style/Widget.Button">
        <item name="android:background">@drawable/encoder_test_button</item>
        <item name="android:textColor">@color/encoder_test_button_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
