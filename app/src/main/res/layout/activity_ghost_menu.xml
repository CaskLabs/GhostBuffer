<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="#10161A">
    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Choose a view" android:textColor="#F2F5F7" android:textSize="18sp"
        android:textStyle="bold" android:paddingBottom="6dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="vertical" android:fadingEdge="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:id="@+id/menu_camera"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
                android:background="@drawable/menu_card" android:clickable="true">
                <TextView android:includeFontPadding="false" android:layout_width="34dp" android:layout_height="wrap_content"
                    android:text="01" android:textColor="#72DDD0" android:textSize="18sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Camera" android:textColor="#F2F5F7" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Live view and rolling capture buffer" android:textColor="#BCC6CC" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#8250;" android:textColor="#72DDD0" android:textSize="24sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menu_gallery"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="8dp" android:background="@drawable/menu_card" android:clickable="true">
                <TextView android:includeFontPadding="false" android:layout_width="34dp" android:layout_height="wrap_content"
                    android:text="02" android:textColor="#72DDD0" android:textSize="18sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Gallery" android:textColor="#F2F5F7" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Saved captures and frames" android:textColor="#BCC6CC" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#8250;" android:textColor="#72DDD0" android:textSize="24sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menu_exposure"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="8dp" android:background="@drawable/menu_card" android:clickable="true">
                <TextView android:includeFontPadding="false" android:layout_width="34dp" android:layout_height="wrap_content"
                    android:text="03" android:textColor="#72DDD0" android:textSize="18sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Settings" android:textColor="#F2F5F7" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Resolution, exposure and Auto" android:textColor="#BCC6CC" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#8250;" android:textColor="#72DDD0" android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:text="&#9650; / &#9660; Select    &#9679; Open    MENU Camera"
        android:gravity="center" android:textColor="#BCC6CC" android:textSize="12sp" />
</LinearLayout>
