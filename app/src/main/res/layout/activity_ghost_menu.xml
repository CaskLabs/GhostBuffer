<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="#10161A">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Choose a view" android:textColor="#F2F5F7" android:textSize="22sp"
        android:textStyle="bold" android:paddingBottom="10dp" />
    <LinearLayout android:id="@+id/menu_camera"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp"
        android:background="@drawable/menu_card" android:clickable="true">
        <TextView android:layout_width="48dp" android:layout_height="wrap_content"
            android:text="01" android:textColor="#72DDD0" android:textSize="22sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Camera" android:textColor="#F2F5F7" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Live view and rolling capture buffer" android:textColor="#BCC6CC" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="&#8250;" android:textColor="#72DDD0" android:textSize="28sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/menu_gallery"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:background="@drawable/menu_card" android:clickable="true">
        <TextView android:layout_width="48dp" android:layout_height="wrap_content"
            android:text="02" android:textColor="#72DDD0" android:textSize="22sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Gallery" android:textColor="#F2F5F7" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Browse saved captures and individual frames" android:textColor="#BCC6CC" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="&#8250;" android:textColor="#72DDD0" android:textSize="28sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/menu_exposure"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:background="@drawable/menu_card" android:clickable="true">
        <TextView android:layout_width="48dp" android:layout_height="wrap_content"
            android:text="03" android:textColor="#72DDD0" android:textSize="22sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Exposure" android:textColor="#F2F5F7" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Shutter, aperture, ISO, EV and Auto" android:textColor="#BCC6CC" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="&#8250;" android:textColor="#72DDD0" android:textSize="28sp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="12dp" android:text="&#9650; / &#9660; Select    &#9679; Open    MENU Camera"
        android:gravity="center" android:textColor="#BCC6CC" android:textSize="14sp" />
</LinearLayout>
