<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/encoder_test_preview_container" android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="10dp" android:background="#10161A">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:includeFontPadding="false" android:text="@string/encoder_test_title" android:textSize="18sp"
            android:textStyle="bold" android:textColor="#F2F5F7" android:paddingBottom="6dp" />
        <TextView android:id="@+id/encoder_test_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:includeFontPadding="false"
            android:text="@string/encoder_test_ready" android:textSize="14sp" android:textColor="#72DDD0"
            android:paddingBottom="6dp" />
        <ScrollView android:id="@+id/encoder_test_scroll" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:scrollbars="vertical">
            <TextView android:id="@+id/encoder_test_details" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/encoder_test_intro"
                android:textSize="12sp" android:textColor="#BCC6CC" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="6dp">
            <Button android:id="@+id/encoder_test_run" style="@style/GhostEncoderTestButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginRight="6dp" android:text="@string/encoder_test_baseline" />
            <Button android:id="@+id/encoder_test_live" style="@style/GhostEncoderTestButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginRight="6dp" android:text="@string/encoder_test_live" />
            <Button android:id="@+id/encoder_test_back" style="@style/GhostEncoderTestButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/encoder_test_back" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="4dp" android:gravity="center" android:textSize="11sp"
            android:textColor="#A4B3BD" android:text="@string/encoder_test_navigation" />
    </LinearLayout>
</RelativeLayout>
