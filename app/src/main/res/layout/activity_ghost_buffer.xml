<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/hud_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#D91B252C"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_initializing"
            android:textColor="#72DDD0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="0.0 s | 0 frames | -- FPS"
            android:textColor="#F2F5F7"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/center_message_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:background="@drawable/message_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_center_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFF00"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hud_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#D91B252C"
        android:orientation="horizontal"
        android:padding="9dp">

        <TextView
            android:id="@+id/tv_bottom_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/hint_camera"
            android:textColor="#BCC6CC"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/exposure_panel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_alignParentTop="true" android:layout_alignParentBottom="true"
        android:layout_margin="6dp" android:padding="8dp" android:orientation="vertical"
        android:background="@drawable/message_panel" android:visibility="gone">
        <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Camera settings" android:textSize="18sp" android:textStyle="bold" android:textColor="#F2F5F7"
            android:paddingBottom="4dp" />
        <TextView android:id="@+id/tv_resolution_status" android:includeFontPadding="false"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Checking camera resolution..." android:textSize="11sp" android:textColor="#72DDD0"
            android:paddingBottom="4dp" />
        <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="UP/DOWN Select   LEFT/RIGHT Change   MENU Done" android:textColor="#BCC6CC"
            android:textSize="11sp" android:paddingBottom="5dp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="vertical" android:fadingEdge="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:id="@+id/capture_resolution" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="34dp" android:layout_marginBottom="3dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp"
                    android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                    android:background="@drawable/menu_card" android:clickable="true">
                    <TextView android:includeFontPadding="false" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Resolution" android:textColor="#BCC6CC" android:textSize="14sp" />
                    <TextView android:id="@+id/capture_resolution_value" android:includeFontPadding="false"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.25"
                        android:gravity="right" android:text="640x480" android:textColor="#72DDD0"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/exposure_mode" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="34dp" android:layout_marginBottom="3dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp"
                    android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/menu_card" android:clickable="true">
                    <TextView android:includeFontPadding="false" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Exposure mode" android:textColor="#BCC6CC" android:textSize="14sp" />
                    <TextView android:includeFontPadding="false" android:id="@+id/exposure_mode_value" android:layout_width="0dp" android:layout_weight="1.25" android:gravity="right"
                        android:layout_height="wrap_content" android:text="Loading..." android:textColor="#72DDD0"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/exposure_shutter" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="34dp" android:layout_marginBottom="3dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp"
                    android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/menu_card" android:clickable="true">
                    <TextView android:includeFontPadding="false" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Shutter speed" android:textColor="#BCC6CC" android:textSize="14sp" />
                    <TextView android:includeFontPadding="false" android:id="@+id/exposure_shutter_value" android:layout_width="0dp" android:layout_weight="1.25" android:gravity="right"
                        android:layout_height="wrap_content" android:text="Loading..." android:textColor="#72DDD0"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/exposure_aperture" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="34dp" android:layout_marginBottom="3dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp"
                    android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/menu_card" android:clickable="true">
                    <TextView android:includeFontPadding="false" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Aperture" android:textColor="#BCC6CC" android:textSize="14sp" />
                    <TextView android:includeFontPadding="false" android:id="@+id/exposure_aperture_value" android:layout_width="0dp" android:layout_weight="1.25" android:gravity="right"
                        android:layout_height="wrap_content" android:text="Loading..." android:textColor="#72DDD0"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/exposure_iso" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="34dp" android:layout_marginBottom="3dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp"
                    android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/menu_card" android:clickable="true">
                    <TextView android:includeFontPadding="false" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="ISO" android:textColor="#BCC6CC" android:textSize="14sp" />
                    <TextView android:includeFontPadding="false" android:id="@+id/exposure_iso_value" android:layout_width="0dp" android:layout_weight="1.25" android:gravity="right"
                        android:layout_height="wrap_content" android:text="Loading..." android:textColor="#72DDD0"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/exposure_ev" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="34dp" android:layout_marginBottom="3dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp"
                    android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/menu_card" android:clickable="true">
                    <TextView android:includeFontPadding="false" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Exposure comp." android:textColor="#BCC6CC" android:textSize="14sp" />
                    <TextView android:includeFontPadding="false" android:id="@+id/exposure_ev_value" android:layout_width="0dp" android:layout_weight="1.25" android:gravity="right"
                        android:layout_height="wrap_content" android:text="Loading..." android:textColor="#72DDD0"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/exposure_wb" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="34dp" android:layout_marginBottom="3dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp"
                    android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/menu_card" android:clickable="true">
                    <TextView android:includeFontPadding="false" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="White balance" android:textColor="#BCC6CC" android:textSize="14sp" />
                    <TextView android:includeFontPadding="false" android:id="@+id/exposure_wb_value" android:layout_width="0dp" android:layout_weight="1.25" android:gravity="right"
                        android:layout_height="wrap_content" android:text="Loading..." android:textColor="#72DDD0"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/encoder_test" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
                    android:background="@drawable/menu_card" android:clickable="true">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:includeFontPadding="false" android:text="Video encoder test"
                        android:textColor="#BCC6CC" android:textSize="14sp" />
                    <TextView android:id="@+id/encoder_test_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:includeFontPadding="false"
                        android:text="Run test" android:textColor="#72DDD0" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <TextView android:includeFontPadding="false" android:id="@+id/tv_exposure_hint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="4dp" android:textColor="#BCC6CC"
            android:textSize="11sp" android:maxLines="2" android:text="Center: Auto exposure + Auto ISO" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="6dp">
            <TextView android:includeFontPadding="false" android:id="@+id/exposure_less" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:padding="5dp" android:minHeight="30dp"
                android:layout_marginRight="4dp" android:gravity="center" android:background="@drawable/menu_card"
                android:text="-" android:textColor="#F2F5F7" android:textSize="14sp" android:clickable="true" />
            <TextView android:includeFontPadding="false" android:id="@+id/exposure_more" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:padding="5dp" android:minHeight="30dp"
                android:layout_marginRight="4dp" android:gravity="center" android:background="@drawable/menu_card"
                android:text="+" android:textColor="#F2F5F7" android:textSize="14sp" android:clickable="true" />
            <TextView android:includeFontPadding="false" android:id="@+id/exposure_auto" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:padding="5dp" android:minHeight="30dp"
                android:layout_marginRight="4dp" android:gravity="center" android:background="@drawable/menu_card"
                android:text="Auto / 0 EV" android:textColor="#F2F5F7" android:textSize="14sp" android:clickable="true" />
            <TextView android:includeFontPadding="false" android:id="@+id/exposure_close" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:padding="5dp" android:minHeight="30dp"
                android:layout_marginRight="4dp" android:gravity="center" android:background="@drawable/menu_card"
                android:text="Done" android:textColor="#F2F5F7" android:textSize="14sp" android:clickable="true" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
