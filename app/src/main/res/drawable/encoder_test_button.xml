<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#151D23" />
            <stroke android:width="1dp" android:color="#29353E" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#246B66" />
            <stroke android:width="2dp" android:color="#A1F3E6" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true" android:drawable="@drawable/menu_card_selected" />
    <item android:state_focused="true" android:drawable="@drawable/menu_card_selected" />
    <item>
        <shape>
            <solid android:color="#1B252C" />
            <stroke android:width="1dp" android:color="#61737E" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
